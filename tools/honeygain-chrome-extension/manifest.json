{
  "manifest_version": 3,
  "name": "NAm Honeygain Dashboard Tracker",
  "version": "1.2.0",
  "description": "Every five minutes, reads only JumpTask balance from inactive Honeygain dashboard tab and closes it; does not count Honeygain balance.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://dashboard.honeygain.com/*",
    "https://nam-qyn8.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.honeygain.com/*"
      ],
      "js": [
        "honeygain.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nam-qyn8.onrender.com/*"
      ],
      "js": [
        "nam.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
