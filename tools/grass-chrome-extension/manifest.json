{
  "manifest_version": 3,
  "name": "NAm Grass Auto-Tab Tracker",
  "version": "1.0.0",
  "description": "Every five minutes, open official Grass dashboard in an inactive tab, read labeled Uptime and Network Points, send to NAm and close.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://app.grass.io/*",
    "https://nam-qyn8.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.grass.io/*"
      ],
      "js": [
        "grass.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nam-qyn8.onrender.com/*"
      ],
      "js": [
        "nam.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
