{
  "manifest_version": 3,
  "name": "RollerCoin Earnings Bridge",
  "version": "2.0.5",
  "description": "Sync RollerCoin earnings by date range into the NAm Project Income dashboard.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://rollercoin.com/*",
    "https://www.rollercoin.com/*",
    "https://nam-qyn8.onrender.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://api.rollercoincalculator.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rollercoin.com/*",
        "https://www.rollercoin.com/*"
      ],
      "js": [
        "rollercoin-page-sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rollercoin.com/*",
        "https://www.rollercoin.com/*"
      ],
      "js": [
        "rollercoin-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://nam-qyn8.onrender.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "dashboard-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
